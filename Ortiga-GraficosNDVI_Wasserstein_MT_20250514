#############################################
## FUNCIÓN PARA CREAR DECILES
#############################################

crear_breaks_deciles <- function(x) {
  breaks <- unique(quantile(x, probs = seq(0, 1, 0.1), na.rm = TRUE))
  
  if (length(breaks) < 11) {
    breaks <- seq(
      min(x, na.rm = TRUE),
      max(x, na.rm = TRUE),
      length.out = 11
    )
  }
  
  return(breaks)
}

breaks_2023 <- crear_breaks_deciles(shp_no_water$z2023)
breaks_2024 <- crear_breaks_deciles(shp_no_water$z2024)
breaks_2025 <- crear_breaks_deciles(shp_no_water$z2025)
breaks_2026 <- crear_breaks_deciles(shp_no_water$z2026)

