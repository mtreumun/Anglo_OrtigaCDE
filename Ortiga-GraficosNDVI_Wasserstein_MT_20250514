distancia_wasserstein_total_2024_2025 <- calcular_distancia_wasserstein_ndvi(shp_no_water, "z2024", "z2025")
distancia_wasserstein_total_2025_2026 <- calcular_distancia_wasserstein_ndvi(shp_no_water, "z2025", "z2026")

wass_df <- data.frame()

for (cat in categorias) {
  
  datos_cat <- shp_no_water[shp_no_water$Tipo_Veg == cat, ]
  
  d1 <- calcular_distancia_wasserstein_ndvi(datos_cat, "z2023", "z2024")
  d2 <- calcular_distancia_wasserstein_ndvi(datos_cat, "z2024", "z2025")
  d3 <- calcular_distancia_wasserstein_ndvi(datos_cat, "z2025", "z2026")
  
  wass_df <- rbind(
    wass_df,
    data.frame(
      Categoria = cat,
      Comparacion = c("2023 vs 2024", "2024 vs 2025", "2025 vs 2026"),
      Distancia = c(d1, d2, d3)
    )
  )
}

