#############################################
## WASSERSTEIN POR NDVI
#############################################

calcular_distancia_wasserstein_ndvi <- function(data, col_a, col_b) {
  
  a <- as.numeric(data[[col_a]])
  b <- as.numeric(data[[col_b]])
  
  a <- a[!is.na(a) & a >= -1 & a <= 1]
  b <- b[!is.na(b) & b >= -1 & b <= 1]
  
  if (length(a) == 0 || length(b) == 0) {
    return(NA)
  }
  
  return(wasserstein1d(a, b))
}

