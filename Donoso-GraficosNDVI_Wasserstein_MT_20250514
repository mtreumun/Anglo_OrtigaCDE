library(sf)
library(ggplot2)
library(dplyr)
library(transport)
library(scales)
library(tibble)

# Cargar capas
path_2023 <- "C:/_1341-ANGLO-RecuperacionEsteroOrtigas/CAPAS/Vegetación/2023/Donoso/20240507_2023.shp"
path_2024 <- "C:/_1341-ANGLO-RecuperacionEsteroOrtigas/CAPAS/Vegetación/2024/Donoso/20240507_2024.shp"
path_2025 <- "C:/_1341-ANGLO-RecuperacionEsteroOrtigas/CAPAS/Vegetación/Mayo_2025/Donoso/20250319_2025.shp"

# Leer shapefiles
sf_2023 <- st_read(path_2023)
sf_2024 <- st_read(path_2024)
sf_2025 <- st_read(path_2025)

# Área por píxel
area_per_pixel_2023 <- 0.000261986596
area_per_pixel_2024 <- 0.000277569761180625
area_per_pixel_2025 <- 0.0002498386 

# Asignar año
sf_2023$Year <- "2023"
sf_2024$Year <- "2024"
sf_2025$Year <- "2025"

# Calcular percentiles y categorizar
percentiles_2023 <- quantile(sf_2023$Mean_ndvi_, probs = seq(0.1, 1, 0.1), na.rm = TRUE)
percentiles_2024 <- quantile(sf_2024$Mean_ndvi_, probs = seq(0.1, 1, 0.1), na.rm = TRUE)
percentiles_2025 <- quantile(sf_2025$Mean_ndvi_, probs = seq(0.1, 1, 0.1), na.rm = TRUE)

sf_2023$NDVI_Category <- cut(sf_2023$Mean_ndvi_, breaks = c(-Inf, percentiles_2023, Inf), labels = 1:11)
sf_2024$NDVI_Category <- cut(sf_2024$Mean_ndvi_, breaks = c(-Inf, percentiles_2024, Inf), labels = 1:11)
sf_2025$NDVI_Category <- cut(sf_2025$Mean_ndvi_, breaks = c(-Inf, percentiles_2025, Inf), labels = 1:11)

# Unir todos los años
datos_combinados <- rbind(sf_2023, sf_2024, sf_2025)

# Agrupación manual de unidades con nombres descriptivos
datos_combinados <- datos_combinados %>%
  mutate(Grupo = case_when(
    ID_Poly_po %in% c(5, 7) ~ "Formación de Carex macloviana",
    ID_Poly_po %in% c(6, 8, 9, 10, 11, 12, 13) ~ "Formación de Patosia clandestina y Carex macloviana",
    ID_Poly_po %in% c(1, 2, 3, 4) ~ "Patosia clandestina y Zameioscirpus gaimardioides",
    TRUE ~ NA_character_
  ))

# HEATMAPS POR GRUPO
for (grupo in unique(na.omit(datos_combinados$Grupo))) {
  data_grupo <- datos_combinados %>%
    filter(Grupo == grupo, !is.na(NDVI_Category)) %>%
    group_by(Year, NDVI_Category) %>%
    summarise(Count = n(), .groups = 'drop') %>%
    group_by(Year) %>%
    mutate(Proporcion = Count / sum(Count))
  
  p <- ggplot(data_grupo, aes(x = as.factor(NDVI_Category), y = Year, fill = Proporcion)) +
    geom_tile() +
    geom_text(aes(label = percent(Proporcion, accuracy = 0.1)), color = "black", size = 3.5) +
    scale_fill_gradient(name = "% del área", low = "#e5f5e0", high = "#238b45", labels = percent_format(accuracy = 0.05)) +
    labs(title = paste("Distribución relativa de NDVI por deciles:", grupo),
         x = "Decil NDVI", y = "Año") +
    theme_minimal() +
    theme(plot.title = element_text(hjust = 0.5, face = "bold"))
  
  print(p)
}

