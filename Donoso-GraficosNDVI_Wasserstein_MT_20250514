# ============================================================
# DISTANCIA DE WASSERSTEIN
# ============================================================

comparaciones <- list(c("2023", "2024"), c("2024", "2025"), c("2025", "2026"))

# --- POR UNIDAD ---
wasserstein_unidades <- tibble(
  Unidad     = integer(),
  Comparación = character(),
  Distancia  = numeric()
)

for (id in unique(datos_combinados$ID_Poly_po)) {
  for (comp in comparaciones) {
    a <- datos_combinados %>%
      filter(ID_Poly_po == id, Year == comp[1], !is.na(Mean_ndvi_),
             Mean_ndvi_ >= -1, Mean_ndvi_ <= 1) %>% pull(Mean_ndvi_)
    b <- datos_combinados %>%
      filter(ID_Poly_po == id, Year == comp[2], !is.na(Mean_ndvi_),
             Mean_ndvi_ >= -1, Mean_ndvi_ <= 1) %>% pull(Mean_ndvi_)
    
    breaks  <- seq(-1, 1, length.out = 11)
    hist_a  <- hist(a, breaks = breaks, plot = FALSE)$counts
    hist_b  <- hist(b, breaks = breaks, plot = FALSE)$counts
    
    if (sum(hist_a) > 0 && sum(hist_b) > 0) {
      norm_a      <- hist_a / sum(hist_a)
      norm_b      <- hist_b / sum(hist_b)
      cost_matrix <- as.matrix(dist(1:10, method = "manhattan"))
      dist_w      <- wasserstein(norm_a, norm_b, costm = cost_matrix)
      wasserstein_unidades <- add_row(wasserstein_unidades,
                                      Unidad      = id,
                                      Comparación = paste(comp[1], "vs", comp[2]),
                                      Distancia   = dist_w)
    }
  }
}

# Gráfico por unidad (escala libre)
p1 <- ggplot(wasserstein_unidades, aes(x = factor(Unidad), y = Distancia, fill = Comparación)) +
  geom_bar(stat = "identity", position = position_dodge()) +
  labs(title = "Distancia de Wasserstein por unidad",
       x = "Unidad de vegetación", y = "Distancia de Wasserstein") +
  theme_minimal()
print(p1)

# Gráfico por unidad (eje Y fijo 0–2)
p1 <- ggplot(wasserstein_unidades, aes(x = factor(Unidad), y = Distancia, fill = Comparación)) +
  geom_bar(stat = "identity", position = position_dodge()) +
  ylim(0, 2) +
  labs(title = "Distancia de Wasserstein por unidad",
